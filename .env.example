# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=teamwork_db
DATABASE_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DATABASE_PORT}/${POSTGRES_DB}?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="your_super_secret_access_jwt_key_here"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="your_super_secret_refresh_jwt_key_here"
REFRESH_TOKEN_EXPIRATION="7d"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Mail (Gmail SMTP) — Tạo App Password tại: myaccount.google.com/apppasswords
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USER="your_gmail@gmail.com"
MAIL_PASS="your_gmail_app_password_16_chars"
MAIL_FROM="your_gmail@gmail.com"

# Frontend URL (for email links)
FRONTEND_URL="http://localhost:3000"
